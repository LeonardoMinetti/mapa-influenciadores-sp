# Copie para .env (NÃO versionar). Nada aqui é necessário para rodar os testes ou o site.

# Google Places API (New) — módulo Google. Exige projeto Cloud COM FATURAMENTO; campos de
# avaliação são faturáveis. O código só chama a API paga com a flag --authorize-billing.
GOOGLE_MAPS_API_KEY=

# Meta (Instagram) — token de app para oEmbed / Graph API. Só funciona para contas que autorizaram o app.
META_APP_ACCESS_TOKEN=

# Opcional: anotação por LLM no pipeline (hoje a anotação desta PoC foi feita em sessão, não por API).
ANTHROPIC_API_KEY=
