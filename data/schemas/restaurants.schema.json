{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restaurants.json (público)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["restaurant_id", "name", "influencers", "post_ids", "review_status", "coordinate_quality"],
    "properties": {
      "restaurant_id": {"type": "string"},
      "name": {"type": "string"},
      "name_source": {"enum": ["mention_handle", "annotator_from_handle", "annotator_from_text", "pin_prefix", "annotator"]},
      "unit_label": {"type": ["string", "null"]},
      "multi_unit_brand": {"type": "boolean"},
      "address_text": {"type": ["string", "null"], "description": "Endereço copiado do texto da publicação; nunca inventado"},
      "municipality": {"type": ["string", "null"]},
      "neighborhood": {"type": ["string", "null"]},
      "lat": {"type": ["number", "null"]},
      "lon": {"type": ["number", "null"]},
      "coordinate_quality": {"enum": ["address_exact", "street_approx", "area", "none"]},
      "geocode_source": {"type": ["string", "null"]},
      "existence_verified": {"type": "boolean", "description": "true só se um POI de mesmo nome foi achado no OSM perto do endereço"},
      "in_sao_paulo_city": {"type": "boolean"},
      "influencers": {"type": "array", "items": {"type": "string"}},
      "post_ids": {"type": "array", "items": {"type": "string"}},
      "review_status": {"enum": ["auto_ok", "pending_review"]},
      "review_reasons": {"type": "array", "items": {"type": "string"}}
    }
  }
}
